# ============================================================
# Proxmox API
# ============================================================

PVE_ENDPOINTS=https://pve1.example.local:8006,https://pve2.example.local:8006,https://pve3.example.local:8006
PVE_TOKEN_ID=user@pve!token
PVE_TOKEN_SECRET=replace-me
PVE_VERIFY_SSL=false

# ============================================================
# SSH access
# ============================================================

PVE_SSH_USER=root
PVE_SSH_KEY=/app/ssh/id_ed25519
PVE_SSH_PORT=22

# Format:
# node-name=ip-address,node-name=ip-address
PVE_NODE_HOSTS=pve=192.168.1.10,pve2=192.168.1.11

# Refresh interval in seconds
REFRESH_INTERVAL=10

# ============================================================
# ProxPilot authentication
# ============================================================

PROXPILOT_AUTH_ENABLED=true
PROXPILOT_AUTH_USERNAME=admin
PROXPILOT_AUTH_PASSWORD=replace-me

# Generate a random secret, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
PROXPILOT_SESSION_SECRET=replace-me

PROXPILOT_COOKIE_SECURE=false
PROXPILOT_SESSION_MAX_AGE=43200

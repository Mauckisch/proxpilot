# ----------------------------------------------------------------------
# Proxmox API
# ----------------------------------------------------------------------

# One or more Proxmox API endpoints (comma separated)
PVE_ENDPOINTS=https://pve1.example.com:8006,https://pve2.example.com:8006

# API token
PVE_TOKEN_ID=api-user@pve!proxpilot
PVE_TOKEN_SECRET=your_api_token_here

# Verify SSL certificates (true/false)
PVE_VERIFY_SSL=true

# ----------------------------------------------------------------------
# SSH
# ----------------------------------------------------------------------

# SSH user used for maintenance actions
PVE_SSH_USER=root

# Path to the SSH private key inside the container
PVE_SSH_KEY=/app/ssh/id_ed25519

# SSH port
PVE_SSH_PORT=22

# Mapping between Proxmox node names and IP addresses
PVE_NODE_HOSTS=pve1=192.168.x.x,pve2=192.168.x.x

# ----------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------

# Refresh interval in seconds
REFRESH_INTERVAL=10

# ============================================================
# Proxmox API
# ============================================================

PVE_ENDPOINTS=https://pve1.example.local:8006,https://pve2.example.local:8006,https://pve3.example.local:8006
PVE_TOKEN_ID=dashboard@pve!dashboard
PVE_TOKEN_SECRET=replace-me
PVE_VERIFY_SSL=false


# ============================================================
# Proxmox node and SSH access
# ============================================================

PVE_SSH_USER=root
PVE_SSH_KEY=/app/ssh/id_ed25519
PVE_SSH_PORT=22

# Mapping format:
# node-name=hostname-or-ip,node-name=hostname-or-ip
#
# Node names must exactly match the names reported by Proxmox.
# This mapping is also required for node-specific console access.
PVE_NODE_HOSTS=pve1=192.168.1.10,pve2=192.168.1.11,pve3=192.168.1.12


# ============================================================
# General application settings
# ============================================================

REFRESH_INTERVAL=10


# ============================================================
# ProxPilot authentication
# ============================================================

PROXPILOT_AUTH_ENABLED=true

# Initial local administrator.
#
# These values are used only when no user with this username
# exists in the SQLite database.
PROXPILOT_AUTH_USERNAME=admin
PROXPILOT_AUTH_PASSWORD=replace-with-a-secure-password

# Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PROXPILOT_SESSION_SECRET=replace-with-a-long-random-secret

# Set to true when ProxPilot is accessed through HTTPS.
#
# The integrated noVNC console requires HTTPS and a
# WebSocket-capable reverse proxy.
PROXPILOT_COOKIE_SECURE=false

# Session lifetime in seconds.
# 43200 seconds = 12 hours.
PROXPILOT_SESSION_MAX_AGE=43200
